{
  "$defs": {
    "authorization_chain": {
      "additionalProperties": false,
      "properties": {
        "authorization_commitment": {
          "$ref": "#/$defs/authorization_commitment"
        },
        "dossier_commitment": {
          "$ref": "#/$defs/dossier_commitment"
        }
      },
      "required": [
        "dossier_commitment",
        "authorization_commitment"
      ],
      "type": "object"
    },
    "authorization_commitment": {
      "additionalProperties": false,
      "properties": {
        "commitment_sha256": {
          "$ref": "#/$defs/sha"
        },
        "profile": {
          "const": "a0x-execution-authorization-json-v2"
        }
      },
      "required": [
        "profile",
        "commitment_sha256"
      ],
      "type": "object"
    },
    "dense": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "cap_bytes": {
                "const": 4194304
              },
              "endpoint_count": {
                "const": 2
              },
              "index_reservation_bytes": {
                "const": 1048576
              },
              "payload_allowance_bytes": {
                "const": 524288
              },
              "vector_count": {
                "const": 192
              },
              "view_site_count": {
                "const": 2
              }
            }
          },
          "if": {
            "properties": {
              "leg": {
                "const": "a0"
              }
            },
            "required": [
              "leg"
            ]
          },
          "then": {
            "properties": {
              "cap_bytes": {
                "const": 33554432
              },
              "endpoint_count": {
                "const": 5
              },
              "index_reservation_bytes": {
                "const": 6291456
              },
              "payload_allowance_bytes": {
                "const": 2097152
              },
              "vector_count": {
                "const": 2400
              },
              "view_site_count": {
                "const": 10
              }
            }
          }
        }
      ],
      "properties": {
        "atomic_dense_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "cap_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "cases": {
          "const": 48
        },
        "dense_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "dense_copy_count": {
          "const": 2
        },
        "endpoint_count": {
          "minimum": 1,
          "type": "integer"
        },
        "hidden_width": {
          "minimum": 1,
          "type": "integer"
        },
        "index_copy_count": {
          "const": 2
        },
        "index_reservation_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "leg": {
          "enum": [
            "a0",
            "r1"
          ]
        },
        "payload_allowance_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "scalar_bytes": {
          "const": 4
        },
        "total_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "vector_count": {
          "minimum": 1,
          "type": "integer"
        },
        "view_site_count": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "leg",
        "cases",
        "view_site_count",
        "endpoint_count",
        "hidden_width",
        "scalar_bytes",
        "vector_count",
        "dense_bytes",
        "dense_copy_count",
        "atomic_dense_bytes",
        "index_copy_count",
        "index_reservation_bytes",
        "payload_allowance_bytes",
        "total_bytes",
        "cap_bytes"
      ],
      "type": "object"
    },
    "dossier_commitment": {
      "additionalProperties": false,
      "properties": {
        "commitment_sha256": {
          "$ref": "#/$defs/sha"
        },
        "profile": {
          "const": "a0x-approval-dossier-json-v2"
        }
      },
      "required": [
        "profile",
        "commitment_sha256"
      ],
      "type": "object"
    },
    "pair": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "dense_bound": {
                "properties": {
                  "leg": {
                    "const": "r1"
                  }
                }
              }
            }
          },
          "if": {
            "properties": {
              "leg": {
                "const": "a0"
              }
            },
            "required": [
              "leg"
            ]
          },
          "then": {
            "properties": {
              "dense_bound": {
                "properties": {
                  "leg": {
                    "const": "a0"
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "binding_profile": {
          "const": "a0x-pair-scope-v2"
        },
        "dense_bound": {
          "$ref": "#/$defs/dense",
          "additionalProperties": false,
          "properties": {
            "atomic_dense_bytes": {
              "minimum": 1,
              "type": "integer"
            },
            "cap_bytes": {
              "enum": [
                33554432,
                4194304
              ]
            },
            "cases": {
              "const": 48,
              "type": "integer"
            },
            "dense_bytes": {
              "minimum": 1,
              "type": "integer"
            },
            "dense_copy_count": {
              "const": 2,
              "type": "integer"
            },
            "endpoint_count": {
              "minimum": 1,
              "type": "integer"
            },
            "hidden_width": {
              "minimum": 1,
              "type": "integer"
            },
            "index_copy_count": {
              "const": 2,
              "type": "integer"
            },
            "index_reservation_bytes": {
              "enum": [
                6291456,
                1048576
              ]
            },
            "leg": {
              "enum": [
                "a0",
                "r1"
              ]
            },
            "payload_allowance_bytes": {
              "enum": [
                2097152,
                524288
              ]
            },
            "scalar_bytes": {
              "const": 4,
              "type": "integer"
            },
            "total_bytes": {
              "minimum": 1,
              "type": "integer"
            },
            "vector_count": {
              "minimum": 1,
              "type": "integer"
            },
            "view_site_count": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "leg",
            "cases",
            "view_site_count",
            "endpoint_count",
            "hidden_width",
            "scalar_bytes",
            "vector_count",
            "dense_bytes",
            "dense_copy_count",
            "atomic_dense_bytes",
            "index_copy_count",
            "index_reservation_bytes",
            "payload_allowance_bytes",
            "total_bytes",
            "cap_bytes"
          ],
          "type": "object"
        },
        "leg": {
          "enum": [
            "a0",
            "r1"
          ]
        },
        "leg_freeze_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "type": "string"
        },
        "model_key": {
          "enum": [
            "gpt2",
            "gpt_neo_125m",
            "qwen2_5_0_5b",
            "qwen3_0_6b_base",
            "smollm2_135m",
            "smollm2_360m"
          ]
        },
        "output_path": {
          "pattern": "^results/a0x/(?:a0|r1)/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        "revision": {
          "pattern": "^[a-f0-9]{40}$",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "binding_profile",
        "dense_bound",
        "leg",
        "leg_freeze_sha256",
        "model_id",
        "model_key",
        "output_path",
        "revision",
        "run_id"
      ],
      "type": "object"
    },
    "path": {
      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$",
      "type": "string"
    },
    "rev": {
      "pattern": "^[a-f0-9]{40}$",
      "type": "string"
    },
    "sha": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "content_reads": {
            "const": 0
          }
        },
        "required": [
          "content_reads"
        ]
      },
      "then": {
        "properties": {
          "observed_sha256": {
            "const": null
          },
          "status": {
            "const": "read_failed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "content_reads": {
            "const": 1
          }
        },
        "required": [
          "content_reads"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "pass",
              "read_failed",
              "hash_mismatch",
              "parse_failed",
              "selection_mismatch"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "pass",
              "hash_mismatch",
              "parse_failed",
              "selection_mismatch"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "observed_sha256": {
            "$ref": "#/$defs/sha"
          }
        }
      }
    }
  ],
  "properties": {
    "activation_receipt_sha256": {
      "$ref": "#/$defs/sha"
    },
    "artifact_class": {
      "const": "a0x-target-read-receipt"
    },
    "authorization_chain": {
      "$ref": "#/$defs/authorization_chain"
    },
    "claim_ids": {
      "maxItems": 0,
      "type": "array"
    },
    "content_reads": {
      "enum": [
        0,
        1
      ]
    },
    "dense_sha256": {
      "$ref": "#/$defs/sha"
    },
    "empirical": {
      "const": true
    },
    "evidence_eligible": {
      "const": false
    },
    "expert_validated": {
      "const": false
    },
    "index_sha256": {
      "$ref": "#/$defs/sha"
    },
    "observed_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "pair_binding": {
      "$ref": "#/$defs/pair"
    },
    "scientific_status": {
      "const": "exploratory"
    },
    "selection_corpus_sha256": {
      "$ref": "#/$defs/sha"
    },
    "status": {
      "enum": [
        "pass",
        "read_failed",
        "hash_mismatch",
        "parse_failed",
        "selection_mismatch"
      ]
    }
  },
  "required": [
    "activation_receipt_sha256",
    "artifact_class",
    "authorization_chain",
    "claim_ids",
    "content_reads",
    "dense_sha256",
    "empirical",
    "evidence_eligible",
    "expert_validated",
    "index_sha256",
    "observed_sha256",
    "pair_binding",
    "scientific_status",
    "selection_corpus_sha256",
    "status"
  ],
  "type": "object"
}
