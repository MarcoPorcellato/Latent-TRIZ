{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_class", "contract_version", "repository", "ccp", "offline", "max_run_count", "stop_boundaries"],
  "properties": {
    "artifact_class": {"const": "a0x-material-execution-contract"},
    "contract_version": {"const": "a0x-material-execution-contract-v2"},
    "repository": {"const": "MarcoPorcellato/Latent-TRIZ"},
    "ccp": {"$ref": "#/$defs/ccp"},
    "gate_a": {"$ref": "#/$defs/gate_a"},
    "offline": {"const": {"network": false, "generation": false, "local_cpu_float32": true}},
    "max_run_count": {"const": 1},
    "stop_boundaries": {"const": ["before_model_load", "after_first_terminal_outcome", "after_one_sealed_target_read"]}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "locator": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)(?!.*file://)(?!.*(?:marco1|Users|private|tmp)/)[A-Za-z0-9._/-]+$"},
    "ccp": {
      "type": "object", "additionalProperties": false,
      "required": ["producer_role", "source_commit", "source_tree", "sha256", "version", "qualification_status", "command_roles", "hash_before_command", "matrix_plan_profile", "matrix_config_binding", "matrix_policy_binding", "location_roles", "matrix_plan_binding"],
      "properties": {
        "producer_role": {"const": "ccp_executable"},
        "source_commit": {"const": "27adf8d0820b3cd96f9c5e149de9b580ae41f639"},
        "source_tree": {"const": "d8e0364d1313fde0898a44517ae6d233d9e10763"},
        "sha256": {"const": "c8021e2322e172686c0a0c07d2b0260eafb5812d085d2306dbbde3fe4e964bd4"},
        "version": {"const": "commit-ci-preflight 0.1.0"},
        "qualification_status": {"const": "terminal_heavy_qualified"},
        "command_roles": {"const": ["admission_status", "resource_status", "plan", "doctor", "dry_run", "repository_run", "guard_exec"]},
        "hash_before_command": {"const": true},
        "matrix_plan_profile": {"const": "matrix-v2-legacy-v1"},
        "matrix_config_binding": {"$ref": "#/$defs/file_binding"},
        "matrix_policy_binding": {"$ref": "#/$defs/file_binding"},
        "location_roles": {"const": {"repository_root": "repository_root", "managed_cache_root": "managed_cache_root"}},
        "matrix_plan_binding": {"$ref": "#/$defs/plan_binding"}
      }
    },
    "file_binding": {"type": "object", "additionalProperties": false, "required": ["locator", "raw_sha256"], "properties": {"locator": {"$ref": "#/$defs/locator"}, "raw_sha256": {"$ref": "#/$defs/sha"}}},
    "gate_a": {"type": "object", "additionalProperties": false, "required": ["provider", "workflow_path", "event", "ref", "required_lanes", "size_ceilings_bytes", "verifier", "predicate_type", "cert_oidc_issuer", "deny_self_hosted_runners", "require_verified_timestamp", "workflow_raw_sha256", "requirements_schema_lock_raw_sha256", "action_manifest_raw_sha256", "lane_manifest_raw_sha256"], "properties": {"provider": {"const": "github-hosted-attestation-v1"}, "workflow_path": {"const": ".github/workflows/a0x-hosted-gate-a.yml"}, "event": {"const": "push"}, "ref": {"const": "refs/heads/main"}, "required_lanes": {"const": ["a0x-no-model", "a0x-synthetic", "documentation-audit", "repository-python311", "repository-python312", "schema-cross-validation-python311", "schema-cross-validation-python312"]}, "size_ceilings_bytes": {"const": {"manifest": 32768, "attestation_bundle": 1048576, "trusted_root": 2097152, "transport": 16384, "verification_receipt": 32768}}, "verifier": {"type": "object", "additionalProperties": false, "required": ["role", "version", "sha256", "policy_raw_sha256"], "properties": {"role": {"const": "github_cli_verifier"}, "version": {"const": "gh version 2.97.0 (2026-07-31)"}, "sha256": {"const": "6a2ab5fa89553eac1f0df50a26a5eaeea9a665d8971f5a51b32487b72c708f5c"}, "policy_raw_sha256": {"const": "e2e11f6bec9740d7e2025eae80fe87fa29d79436faa3a2c5c1ca7d55ceb9e4b4"}}}, "predicate_type": {"const": "https://slsa.dev/provenance/v1"}, "cert_oidc_issuer": {"const": "https://token.actions.githubusercontent.com"}, "deny_self_hosted_runners": {"const": true}, "require_verified_timestamp": {"const": true}, "workflow_raw_sha256": {"const": "e61045e9592237aadb6057ca752061855135109fd9e5bbdf508e55c706ab1458"}, "requirements_schema_lock_raw_sha256": {"const": "0bbafebbe4fdb6028f5e8565eae397d18d6ace90e7e5e2c5b9472aa924162be7"}, "action_manifest_raw_sha256": {"const": "f84777250a50082cd4f2390d949193c73d983475d32c08b02536fdf5ebd8a7fd"}, "lane_manifest_raw_sha256": {"const": "4a6754e77e4a440d9e1af03d16017272e194bc6953cec16dd9473aa0b5929a97"}}},
    "plan_binding": {"type": "object", "additionalProperties": false, "required": ["plan_output_sha256", "outer_digest", "python311_digest", "python312_digest"], "properties": {"plan_output_sha256": {"const": "0969a1eeb62b2a92593cda0b75c8814d7eca893bebc736ec968f02aa9f2a5fad"}, "outer_digest": {"const": "sha256:8eb0172c30aac8f9b47f65cebd222ee6615b17e4053a5a16e2be5583f3a10331"}, "python311_digest": {"const": "sha256:aa69a8795e20733a516fac99b253cfc26a9f963825ff1fa9ca5638364f7fc943"}, "python312_digest": {"const": "sha256:072e50972a02f2df710bf81620ca058d230f0637bcc16a47ba35562fe1358510"}}}
  }
