{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_class", "claim_ids", "commitment_profile", "qualification_status", "empirical", "evidence_eligible", "expert_validated", "scientific_status", "repository", "source_head", "material_contract_raw_sha256", "ccp", "generation", "max_qualification_run_count", "stop_boundary", "authorization_id"],
  "properties": {
    "artifact_class": {"const": "a0x-qualification-authorization"},
    "claim_ids": {"type": "array", "maxItems": 0},
    "commitment_profile": {"const": "a0x-qualification-authorization-json-v1"},
    "qualification_status": {"const": "authorized"},
    "empirical": {"const": true},
    "evidence_eligible": {"const": false},
    "expert_validated": {"const": false},
    "scientific_status": {"const": "exploratory"},
    "repository": {"const": "MarcoPorcellato/Latent-TRIZ"},
    "source_head": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "material_contract_raw_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ccp": {"type": "object", "additionalProperties": false, "required": ["path", "source_commit", "qualified_source_tree", "sha256", "version"], "properties": {"path": {"const": "/Users/marco1/.cargo/bin/commit-ci-preflight"}, "source_commit": {"const": "3fccc197e5055a2759ee7afe51b91133938ec904"}, "qualified_source_tree": {"const": "9e478c1489a9926772e8ab8bea21bd57470494b6"}, "sha256": {"const": "b8d26013800c99ba806506a0539a9ddc781bfab52f95c8f1dbdff1b65c2fcd4c"}, "version": {"const": "commit-ci-preflight 0.1.0"}}},
    "generation": {"type": "integer", "minimum": 1},
    "max_qualification_run_count": {"const": 1},
    "stop_boundary": {"const": "after_repository_qualification_receipt"},
    "authorization_id": {"type": "string", "minLength": 1}
  }
}
