{
  "$defs": {
    "bundle_input": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^\\.a0x-runtime/gate-a/evidence/[a-f0-9]{40}/hosted-gate-a-attestation\\.bundle\\.jsonl$",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "dense": {
      "additionalProperties": false,
      "properties": {
        "atomic_dense_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "cap_bytes": {
          "enum": [
            33554432,
            4194304
          ]
        },
        "cases": {
          "const": 48,
          "type": "integer"
        },
        "dense_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "dense_copy_count": {
          "const": 2,
          "type": "integer"
        },
        "endpoint_count": {
          "minimum": 1,
          "type": "integer"
        },
        "hidden_width": {
          "minimum": 1,
          "type": "integer"
        },
        "index_copy_count": {
          "const": 2,
          "type": "integer"
        },
        "index_reservation_bytes": {
          "enum": [
            6291456,
            1048576
          ]
        },
        "leg": {
          "enum": [
            "a0",
            "r1"
          ]
        },
        "payload_allowance_bytes": {
          "enum": [
            2097152,
            524288
          ]
        },
        "scalar_bytes": {
          "const": 4,
          "type": "integer"
        },
        "total_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "vector_count": {
          "minimum": 1,
          "type": "integer"
        },
        "view_site_count": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "leg",
        "cases",
        "view_site_count",
        "endpoint_count",
        "hidden_width",
        "scalar_bytes",
        "vector_count",
        "dense_bytes",
        "dense_copy_count",
        "atomic_dense_bytes",
        "index_copy_count",
        "index_reservation_bytes",
        "payload_allowance_bytes",
        "total_bytes",
        "cap_bytes"
      ],
      "type": "object"
    },
    "hosted_inputs": {
      "additionalProperties": false,
      "properties": {
        "attestation_bundle": {
          "$ref": "#/$defs/bundle_input"
        },
        "manifest": {
          "$ref": "#/$defs/manifest_input"
        },
        "transport": {
          "$ref": "#/$defs/transport_input"
        },
        "trusted_root": {
          "$ref": "#/$defs/root_input"
        }
      },
      "required": [
        "manifest",
        "attestation_bundle",
        "trusted_root",
        "transport"
      ],
      "type": "object"
    },
    "manifest_input": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^\\.a0x-runtime/gate-a/evidence/[a-f0-9]{40}/hosted-gate-a-evidence\\.json$",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "pair": {
      "additionalProperties": false,
      "properties": {
        "binding_profile": {
          "const": "a0x-pair-scope-v2"
        },
        "dense_bound": {
          "$ref": "#/$defs/dense",
          "additionalProperties": false,
          "properties": {
            "atomic_dense_bytes": {
              "minimum": 1,
              "type": "integer"
            },
            "cap_bytes": {
              "enum": [
                33554432,
                4194304
              ]
            },
            "cases": {
              "const": 48,
              "type": "integer"
            },
            "dense_bytes": {
              "minimum": 1,
              "type": "integer"
            },
            "dense_copy_count": {
              "const": 2,
              "type": "integer"
            },
            "endpoint_count": {
              "minimum": 1,
              "type": "integer"
            },
            "hidden_width": {
              "minimum": 1,
              "type": "integer"
            },
            "index_copy_count": {
              "const": 2,
              "type": "integer"
            },
            "index_reservation_bytes": {
              "enum": [
                6291456,
                1048576
              ]
            },
            "leg": {
              "enum": [
                "a0",
                "r1"
              ]
            },
            "payload_allowance_bytes": {
              "enum": [
                2097152,
                524288
              ]
            },
            "scalar_bytes": {
              "const": 4,
              "type": "integer"
            },
            "total_bytes": {
              "minimum": 1,
              "type": "integer"
            },
            "vector_count": {
              "minimum": 1,
              "type": "integer"
            },
            "view_site_count": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "leg",
            "cases",
            "view_site_count",
            "endpoint_count",
            "hidden_width",
            "scalar_bytes",
            "vector_count",
            "dense_bytes",
            "dense_copy_count",
            "atomic_dense_bytes",
            "index_copy_count",
            "index_reservation_bytes",
            "payload_allowance_bytes",
            "total_bytes",
            "cap_bytes"
          ],
          "type": "object"
        },
        "leg": {
          "enum": [
            "a0",
            "r1"
          ]
        },
        "leg_freeze_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "type": "string"
        },
        "model_key": {
          "enum": [
            "gpt2",
            "gpt_neo_125m",
            "qwen2_5_0_5b",
            "qwen3_0_6b_base",
            "smollm2_135m",
            "smollm2_360m"
          ]
        },
        "output_path": {
          "pattern": "^results/a0x/(?:a0|r1)/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        "revision": {
          "pattern": "^[a-f0-9]{40}$",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "binding_profile",
        "dense_bound",
        "leg",
        "leg_freeze_sha256",
        "model_id",
        "model_key",
        "output_path",
        "revision",
        "run_id"
      ],
      "type": "object"
    },
    "revision": {
      "pattern": "^[a-f0-9]{40}$",
      "type": "string"
    },
    "root_input": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^\\.a0x-runtime/gate-a/evidence/[a-f0-9]{40}/github-trusted-root\\.jsonl$",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "sha": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "timestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
      "type": "string"
    },
    "transport_input": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^\\.a0x-runtime/gate-a/evidence/[a-f0-9]{40}/hosted-gate-a-transport\\.json$",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "verifier": {
      "additionalProperties": false,
      "properties": {
        "policy_raw_sha256": {
          "$ref": "#/$defs/sha"
        },
        "role": {
          "const": "github_cli_verifier"
        },
        "sha256": {
          "const": "6a2ab5fa89553eac1f0df50a26a5eaeea9a665d8971f5a51b32487b72c708f5c"
        },
        "version": {
          "const": "gh version 2.97.0 (2026-07-31)"
        }
      },
      "required": [
        "role",
        "version",
        "sha256",
        "policy_raw_sha256"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/MarcoPorcellato/Latent-TRIZ/schemas/a0x-hosted-gate-a-verification-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_class": {
      "const": "a0x-hosted-gate-a-verification-receipt"
    },
    "authorization_raw_sha256": {
      "$ref": "#/$defs/sha"
    },
    "hosted_inputs": {
      "$ref": "#/$defs/hosted_inputs"
    },
    "pair_binding": {
      "$ref": "#/$defs/pair"
    },
    "qualified_source_head": {
      "$ref": "#/$defs/revision"
    },
    "qualified_source_tree": {
      "$ref": "#/$defs/revision"
    },
    "receipt_profile": {
      "const": "a0x-hosted-gate-a-verification-receipt-v1"
    },
    "repository": {
      "const": "MarcoPorcellato/Latent-TRIZ"
    },
    "verification_status": {
      "const": "verified"
    },
    "verified_at": {
      "$ref": "#/$defs/timestamp"
    },
    "verifier": {
      "$ref": "#/$defs/verifier"
    }
  },
  "required": [
    "artifact_class",
    "receipt_profile",
    "verification_status",
    "repository",
    "qualified_source_head",
    "qualified_source_tree",
    "pair_binding",
    "authorization_raw_sha256",
    "hosted_inputs",
    "verifier",
    "verified_at"
  ],
  "type": "object"
}
