{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_class", "observation_profile", "pair_binding", "source_head", "ccp", "source", "resource", "admission", "runtime", "commands"],
  "properties": {
    "artifact_class": {"const": "a0x-guard-preflight-observation"},
    "observation_profile": {"const": "a0x-guard-preflight-observation-v1"},
    "pair_binding": {"$ref": "#/$defs/pair"},
    "source_head": {"$ref": "#/$defs/rev"},
    "ccp": {"$ref": "#/$defs/ccp"},
    "source": {"$ref": "#/$defs/source"},
    "resource": {"$ref": "#/$defs/resource"},
    "admission": {"$ref": "#/$defs/admission"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "commands": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/command"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rev": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "locator": {"type":"string","pattern":"^(?!/)(?!.*\\.\\.)(?!.*file://)[A-Za-z0-9._/-]+$"},
    "ccp": {"type":"object","additionalProperties":false,"required":["role","source_commit","qualified_source_tree","sha256","version"],"properties":{"role":{"const":"ccp"},"source_commit":{"const":"27adf8d0820b3cd96f9c5e149de9b580ae41f639"},"qualified_source_tree":{"const":"d8e0364d1313fde0898a44517ae6d233d9e10763"},"sha256":{"const":"c8021e2322e172686c0a0c07d2b0260eafb5812d085d2306dbbde3fe4e964bd4"},"version":{"const":"commit-ci-preflight 0.1.0"}}},
    "source": {"type":"object","additionalProperties":false,"required":["head","clean"],"properties":{"head":{"$ref":"#/$defs/rev"},"clean":{"const":true}}},
    "resource": {"type":"object","additionalProperties":false,"required":["decision"],"properties":{"decision":{"const":"admit"}}},
    "admission": {"type":"object","additionalProperties":false,"required":["active","queue_count","slot_state"],"properties":{"active":{"const":false},"queue_count":{"const":0},"slot_state":{"const":"free"}}},
    "runtime": {"type":"object","additionalProperties":false,"required":["intended_runtime_responsive","active_container_count"],"properties":{"intended_runtime_responsive":{"const":true},"active_container_count":{"const":0}}},
    "command": {"type":"object","additionalProperties":false,"required":["role","exit_code","output_sha256","output_bytes"],"properties":{"role":{"enum":["ccp_version","resource_status","admission_status","git_source_state","docker_context","docker_active_count"]},"exit_code":{"const":0},"output_sha256":{"$ref":"#/$defs/sha"},"output_bytes":{"type":"integer","minimum":0}}},
    "dense": {"type": "object", "additionalProperties": false, "required": ["leg", "cases", "view_site_count", "endpoint_count", "hidden_width", "scalar_bytes", "vector_count", "dense_bytes", "dense_copy_count", "atomic_dense_bytes", "index_copy_count", "index_reservation_bytes", "payload_allowance_bytes", "total_bytes", "cap_bytes"], "properties": {"leg": {"enum": ["a0", "r1"]}, "cases": {"const": 48}, "view_site_count": {"type": "integer", "minimum": 1}, "endpoint_count": {"type": "integer", "minimum": 1}, "hidden_width": {"type": "integer", "minimum": 1}, "scalar_bytes": {"const": 4}, "vector_count": {"type": "integer", "minimum": 1}, "dense_bytes": {"type": "integer", "minimum": 1}, "dense_copy_count": {"const": 2}, "atomic_dense_bytes": {"type": "integer", "minimum": 1}, "index_copy_count": {"const": 2}, "index_reservation_bytes": {"type": "integer", "minimum": 1}, "payload_allowance_bytes": {"type": "integer", "minimum": 1}, "total_bytes": {"type": "integer", "minimum": 1}, "cap_bytes": {"type": "integer", "minimum": 1}}},
    "pair": {"type": "object", "additionalProperties": false, "required": ["binding_profile", "dense_bound", "leg", "leg_freeze_sha256", "model_id", "model_key", "output_path", "revision", "run_id"], "properties": {"binding_profile": {"const": "a0x-pair-scope-v2"}, "dense_bound": {"$ref": "#/$defs/dense"}, "leg": {"enum": ["a0", "r1"]}, "leg_freeze_sha256": {"$ref": "#/$defs/sha"}, "model_id": {"type": "string", "minLength": 1}, "model_key": {"type": "string", "minLength": 1}, "output_path": {"$ref": "#/$defs/locator"}, "revision": {"$ref": "#/$defs/rev"}, "run_id": {"type": "string", "minLength": 1}}},
    "commitment": {"type": "object", "additionalProperties": false, "required": ["profile", "commitment_sha256"], "properties": {"profile": {"enum": ["a0x-approval-dossier-json-v2", "a0x-execution-authorization-json-v2"]}, "commitment_sha256": {"$ref": "#/$defs/sha"}}},
    "authorization_chain": {"type": "object", "additionalProperties": false, "required": ["dossier_commitment", "authorization_commitment"], "properties": {"dossier_commitment": {"$ref": "#/$defs/commitment"}, "authorization_commitment": {"$ref": "#/$defs/commitment"}}}
  }
}
