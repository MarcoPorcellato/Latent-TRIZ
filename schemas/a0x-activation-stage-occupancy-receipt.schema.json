{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actual_total_bytes",
    "artifact_class",
    "authorization_chain",
    "cap_bytes",
    "claim_ids",
    "empirical",
    "evidence_eligible",
    "expert_validated",
    "included_paths",
    "leg",
    "occupancy_scope",
    "pair_binding",
    "scientific_status"
  ],
  "properties": {
    "actual_total_bytes": {"type": "integer", "minimum": 0},
    "artifact_class": {"const": "a0x-activation-stage-occupancy-receipt"},
    "authorization_chain": {"$ref": "#/$defs/authorization_chain"},
    "cap_bytes": {"type": "integer", "minimum": 1},
    "claim_ids": {"type": "array", "maxItems": 0},
    "empirical": {"const": true},
    "evidence_eligible": {"const": false},
    "expert_validated": {"const": false},
    "included_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/path"}
    },
    "leg": {"enum": ["a0", "r1"]},
    "occupancy_scope": {"const": "activation_stage"},
    "pair_binding": {"$ref": "#/$defs/pair"},
    "scientific_status": {"const": "exploratory"}
  },
  "allOf": [
    {
      "if": {"properties": {"pair_binding": {"properties": {"leg": {"const": "a0"}}}}, "required": ["pair_binding"]},
      "then": {"properties": {"leg": {"const": "a0"}}},
      "else": {"properties": {"leg": {"const": "r1"}}}
    }
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rev": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"},
    "dense": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leg", "cases", "view_site_count", "endpoint_count", "hidden_width",
        "scalar_bytes", "vector_count", "dense_bytes", "dense_copy_count",
        "atomic_dense_bytes", "index_copy_count", "index_reservation_bytes",
        "payload_allowance_bytes", "total_bytes", "cap_bytes"
      ],
      "properties": {
        "leg": {"enum": ["a0", "r1"]},
        "cases": {"const": 48},
        "view_site_count": {"type": "integer", "minimum": 1},
        "endpoint_count": {"type": "integer", "minimum": 1},
        "hidden_width": {"type": "integer", "minimum": 1},
        "scalar_bytes": {"const": 4},
        "vector_count": {"type": "integer", "minimum": 1},
        "dense_bytes": {"type": "integer", "minimum": 1},
        "dense_copy_count": {"const": 2},
        "atomic_dense_bytes": {"type": "integer", "minimum": 1},
        "index_copy_count": {"const": 2},
        "index_reservation_bytes": {"type": "integer", "minimum": 1},
        "payload_allowance_bytes": {"type": "integer", "minimum": 1},
        "total_bytes": {"type": "integer", "minimum": 1},
        "cap_bytes": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"leg": {"const": "a0"}}, "required": ["leg"]},
          "then": {
            "properties": {
              "view_site_count": {"const": 10}, "endpoint_count": {"const": 5},
              "vector_count": {"const": 2400}, "index_reservation_bytes": {"const": 6291456},
              "payload_allowance_bytes": {"const": 2097152}, "cap_bytes": {"const": 33554432}
            }
          },
          "else": {
            "properties": {
              "view_site_count": {"const": 2}, "endpoint_count": {"const": 2},
              "vector_count": {"const": 192}, "index_reservation_bytes": {"const": 1048576},
              "payload_allowance_bytes": {"const": 524288}, "cap_bytes": {"const": 4194304}
            }
          }
        }
      ]
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_profile", "dense_bound", "leg", "leg_freeze_sha256", "model_id",
        "model_key", "output_path", "revision", "run_id"
      ],
      "properties": {
        "binding_profile": {"const": "a0x-pair-scope-v2"},
        "dense_bound": {"$ref": "#/$defs/dense"},
        "leg": {"enum": ["a0", "r1"]},
        "leg_freeze_sha256": {"$ref": "#/$defs/sha"},
        "model_id": {"type": "string", "minLength": 1},
        "model_key": {"type": "string", "minLength": 1},
        "output_path": {"$ref": "#/$defs/path"},
        "revision": {"$ref": "#/$defs/rev"},
        "run_id": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"leg": {"const": "a0"}}, "required": ["leg"]},
          "then": {"properties": {"dense_bound": {"properties": {"leg": {"const": "a0"}}}}},
          "else": {"properties": {"dense_bound": {"properties": {"leg": {"const": "r1"}}}}}
        }
      ]
    },
    "commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "commitment_sha256"],
      "properties": {"profile": {"type": "string", "minLength": 1}, "commitment_sha256": {"$ref": "#/$defs/sha"}}
    },
    "authorization_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dossier_commitment", "authorization_commitment"],
      "properties": {
        "dossier_commitment": {
          "allOf": [
            {"$ref": "#/$defs/commitment"},
            {"properties": {"profile": {"const": "a0x-approval-dossier-json-v2"}}}
          ]
        },
        "authorization_commitment": {
          "allOf": [
            {"$ref": "#/$defs/commitment"},
            {"properties": {"profile": {"const": "a0x-execution-authorization-json-v2"}}}
          ]
        }
      }
    }
  }
}
