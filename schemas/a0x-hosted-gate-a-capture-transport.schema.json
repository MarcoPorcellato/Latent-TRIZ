{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoPorcellato/Latent-TRIZ/schemas/a0x-hosted-gate-a-capture-transport.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "run_id", "run_attempt", "head_sha", "archive_digest", "archive_size_bytes", "created_at", "expires_at", "captured_at"],
  "properties": {
    "artifact_id": {"$ref": "#/$defs/positive_integer"},
    "run_id": {"$ref": "#/$defs/positive_integer"},
    "run_attempt": {"type": "integer", "const": 1},
    "head_sha": {"$ref": "#/$defs/revision"},
    "archive_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "archive_size_bytes": {"$ref": "#/$defs/positive_integer"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "captured_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "positive_integer": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"}
  }
}
