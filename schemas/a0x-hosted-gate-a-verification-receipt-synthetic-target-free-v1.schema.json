{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoPorcellato/Latent-TRIZ/schemas/a0x-hosted-gate-a-verification-receipt-synthetic-target-free-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_class", "receipt_profile", "qualification_context", "verification_status",
    "repository", "qualified_source_head", "qualified_source_tree", "pair_binding",
    "authorization_raw_sha256", "hosted_inputs", "verifier", "verified_at"
  ],
  "properties": {
    "artifact_class": {"const": "a0x-hosted-gate-a-verification-receipt-synthetic-target-free"},
    "receipt_profile": {"const": "a0x-hosted-gate-a-verification-receipt-synthetic-target-free-v1"},
    "qualification_context": {"const": "synthetic-target-free"},
    "verification_status": {"const": "verified"},
    "repository": {"const": "MarcoPorcellato/Latent-TRIZ"},
    "qualified_source_head": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "qualified_source_tree": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "pair_binding": {"type": "object"},
    "authorization_raw_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "hosted_inputs": {"type": "object", "additionalProperties": false, "required": ["manifest", "attestation_bundle", "trusted_root", "transport"], "properties": {
      "manifest": {"type": "object"}, "attestation_bundle": {"type": "object"},
      "trusted_root": {"type": "object"}, "transport": {"type": "object"}
    }},
    "verifier": {"type": "object", "additionalProperties": false, "required": ["role", "version", "sha256", "policy_raw_sha256"], "properties": {
      "role": {"const": "github_cli_verifier"},
      "version": {"type": "string", "minLength": 1},
      "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "policy_raw_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    }},
    "verified_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
