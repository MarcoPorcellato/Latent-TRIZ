{
  "$defs": {
    "asset": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "raw_sha256": {
          "$ref": "#/$defs/sha"
        },
        "repository_relative_path": {
          "$ref": "#/$defs/path"
        },
        "role": {
          "enum": [
            "dense",
            "index"
          ]
        }
      },
      "required": [
        "role",
        "repository_relative_path",
        "bytes",
        "raw_sha256"
      ],
      "type": "object"
    },
    "authorization_chain": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": false,
          "if": {
            "properties": {
              "dossier_commitment": {
                "properties": {
                  "profile": {
                    "const": "a0x-approval-dossier-json-v2"
                  }
                },
                "required": [
                  "profile"
                ]
              }
            }
          },
          "then": true
        },
        {
          "else": false,
          "if": {
            "properties": {
              "authorization_commitment": {
                "properties": {
                  "profile": {
                    "const": "a0x-execution-authorization-json-v2"
                  }
                },
                "required": [
                  "profile"
                ]
              }
            }
          },
          "then": true
        }
      ],
      "properties": {
        "authorization_commitment": {
          "$ref": "#/$defs/commitment"
        },
        "dossier_commitment": {
          "$ref": "#/$defs/commitment"
        }
      },
      "required": [
        "dossier_commitment",
        "authorization_commitment"
      ],
      "type": "object"
    },
    "commitment": {
      "additionalProperties": false,
      "properties": {
        "commitment_sha256": {
          "$ref": "#/$defs/sha"
        },
        "profile": {
          "enum": [
            "a0x-approval-dossier-json-v2",
            "a0x-execution-authorization-json-v2"
          ]
        }
      },
      "required": [
        "profile",
        "commitment_sha256"
      ],
      "type": "object"
    },
    "dense": {
      "additionalProperties": false,
      "properties": {
        "atomic_dense_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "cap_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "cases": {
          "const": 48
        },
        "dense_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "dense_copy_count": {
          "const": 2
        },
        "endpoint_count": {
          "minimum": 1,
          "type": "integer"
        },
        "hidden_width": {
          "minimum": 1,
          "type": "integer"
        },
        "index_copy_count": {
          "const": 2
        },
        "index_reservation_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "leg": {
          "enum": [
            "a0",
            "r1"
          ]
        },
        "payload_allowance_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "scalar_bytes": {
          "const": 4
        },
        "total_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "vector_count": {
          "minimum": 1,
          "type": "integer"
        },
        "view_site_count": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "leg",
        "cases",
        "view_site_count",
        "endpoint_count",
        "hidden_width",
        "scalar_bytes",
        "vector_count",
        "dense_bytes",
        "dense_copy_count",
        "atomic_dense_bytes",
        "index_copy_count",
        "index_reservation_bytes",
        "payload_allowance_bytes",
        "total_bytes",
        "cap_bytes"
      ],
      "type": "object"
    },
    "pair": {
      "additionalProperties": false,
      "properties": {
        "binding_profile": {
          "const": "a0x-pair-scope-v2"
        },
        "dense_bound": {
          "$ref": "#/$defs/dense",
          "additionalProperties": false,
          "properties": {
            "atomic_dense_bytes": {
              "minimum": 1,
              "type": "integer"
            },
            "cap_bytes": {
              "enum": [
                33554432,
                4194304
              ]
            },
            "cases": {
              "const": 48,
              "type": "integer"
            },
            "dense_bytes": {
              "minimum": 1,
              "type": "integer"
            },
            "dense_copy_count": {
              "const": 2,
              "type": "integer"
            },
            "endpoint_count": {
              "minimum": 1,
              "type": "integer"
            },
            "hidden_width": {
              "minimum": 1,
              "type": "integer"
            },
            "index_copy_count": {
              "const": 2,
              "type": "integer"
            },
            "index_reservation_bytes": {
              "enum": [
                6291456,
                1048576
              ]
            },
            "leg": {
              "enum": [
                "a0",
                "r1"
              ]
            },
            "payload_allowance_bytes": {
              "enum": [
                2097152,
                524288
              ]
            },
            "scalar_bytes": {
              "const": 4,
              "type": "integer"
            },
            "total_bytes": {
              "minimum": 1,
              "type": "integer"
            },
            "vector_count": {
              "minimum": 1,
              "type": "integer"
            },
            "view_site_count": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "leg",
            "cases",
            "view_site_count",
            "endpoint_count",
            "hidden_width",
            "scalar_bytes",
            "vector_count",
            "dense_bytes",
            "dense_copy_count",
            "atomic_dense_bytes",
            "index_copy_count",
            "index_reservation_bytes",
            "payload_allowance_bytes",
            "total_bytes",
            "cap_bytes"
          ],
          "type": "object"
        },
        "leg": {
          "enum": [
            "a0",
            "r1"
          ]
        },
        "leg_freeze_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "type": "string"
        },
        "model_key": {
          "enum": [
            "gpt2",
            "gpt_neo_125m",
            "qwen2_5_0_5b",
            "qwen3_0_6b_base",
            "smollm2_135m",
            "smollm2_360m"
          ]
        },
        "output_path": {
          "pattern": "^results/a0x/(?:a0|r1)/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        "revision": {
          "pattern": "^[a-f0-9]{40}$",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "binding_profile",
        "dense_bound",
        "leg",
        "leg_freeze_sha256",
        "model_id",
        "model_key",
        "output_path",
        "revision",
        "run_id"
      ],
      "type": "object"
    },
    "path": {
      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$",
      "type": "string"
    },
    "rev": {
      "pattern": "^[a-f0-9]{40}$",
      "type": "string"
    },
    "sha": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_class": {
      "const": "a0x-external-assets-locator"
    },
    "assets": {
      "allOf": [
        {
          "contains": {
            "properties": {
              "role": {
                "const": "dense"
              }
            },
            "required": [
              "role"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "index"
              }
            },
            "required": [
              "role"
            ]
          }
        }
      ],
      "items": {
        "$ref": "#/$defs/asset"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "authorization_chain": {
      "$ref": "#/$defs/authorization_chain"
    },
    "claim_ids": {
      "maxItems": 0,
      "type": "array"
    },
    "empirical": {
      "const": true
    },
    "evidence_eligible": {
      "const": false
    },
    "expert_validated": {
      "const": false
    },
    "locator_profile": {
      "const": "a0x-external-assets-locator-v1"
    },
    "pair_binding": {
      "$ref": "#/$defs/pair"
    },
    "scientific_status": {
      "const": "exploratory"
    }
  },
  "required": [
    "artifact_class",
    "assets",
    "authorization_chain",
    "claim_ids",
    "empirical",
    "evidence_eligible",
    "expert_validated",
    "locator_profile",
    "pair_binding",
    "scientific_status"
  ],
  "type": "object"
}
