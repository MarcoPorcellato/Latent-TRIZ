{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_target_content_reads",
    "artifact_class",
    "authorization_chain",
    "claim_ids",
    "empirical",
    "evidence_eligible",
    "expert_validated",
    "pair_binding",
    "scientific_status",
    "sealed_from_state",
    "statistical_result",
    "status",
    "target_read_receipt_sha256"
  ],
  "properties": {
    "artifact_class": {
      "const": "a0x-terminal-result"
    },
    "empirical": {
      "const": true
    },
    "scientific_status": {
      "const": "exploratory"
    },
    "evidence_eligible": {
      "const": false
    },
    "expert_validated": {
      "const": false
    },
    "claim_ids": {
      "type": "array",
      "maxItems": 0
    },
    "pair_binding": {
      "$ref": "#/$defs/pair"
    },
    "status": {
      "enum": [
        "positive",
        "null",
        "non_interpretable",
        "incompatible",
        "failed"
      ]
    },
    "sealed_from_state": {
      "enum": ["preflight", "activation", "analysis"]
    },
    "analysis_target_content_reads": {
      "enum": [
        0,
        1
      ]
    },
    "target_read_receipt_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "statistical_result": {
      "type": [
        "object",
        "null"
      ]
    },
    "authorization_chain": {
      "$ref": "#/$defs/authorization_chain"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "analysis_target_content_reads": {
            "const": 1
          }
        },
        "required": [
          "analysis_target_content_reads"
        ]
      },
      "then": {
        "properties": {
          "target_read_receipt_sha256": {
            "$ref": "#/$defs/sha"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"enum": ["positive", "null", "non_interpretable"]}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "sealed_from_state": {"const": "analysis"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "sealed_from_state": {"enum": ["preflight", "activation"]}
        },
        "required": ["sealed_from_state"]
      },
      "then": {
        "properties": {
          "status": {"enum": ["incompatible", "failed"]},
          "analysis_target_content_reads": {"const": 0},
          "target_read_receipt_sha256": {"const": null},
          "statistical_result": {"const": null}
        }
      }
    },
    {
      "if": {
        "properties": {
          "sealed_from_state": {"const": "analysis"}
        },
        "required": ["sealed_from_state"]
      },
      "then": {
        "properties": {
          "target_read_receipt_sha256": {"$ref": "#/$defs/sha"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "positive",
              "null"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "analysis_target_content_reads": {
            "const": 1
          },
          "target_read_receipt_sha256": {
            "$ref": "#/$defs/sha"
          },
          "statistical_result": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "non_interpretable"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "analysis_target_content_reads": {
            "const": 1
          },
          "target_read_receipt_sha256": {
            "$ref": "#/$defs/sha"
          },
          "statistical_result": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "incompatible",
              "failed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "statistical_result": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pair_binding": {
            "properties": {
              "leg": {
                "const": "a0"
              }
            },
            "required": [
              "leg"
            ]
          }
        }
      },
      "then": {
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "positive",
                    "null"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "statistical_result": {
                  "$ref": "#/$defs/result"
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "pair_binding": {
            "properties": {
              "leg": {
                "const": "r1"
              }
            },
            "required": [
              "leg"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "pair_binding": {
            "$ref": "#/$defs/r1_pair"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "positive",
                    "null"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "statistical_result": {
                  "$ref": "#/$defs/r1_result"
                }
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rev": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
    },
    "dense": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leg",
        "cases",
        "view_site_count",
        "endpoint_count",
        "hidden_width",
        "scalar_bytes",
        "vector_count",
        "dense_bytes",
        "dense_copy_count",
        "atomic_dense_bytes",
        "index_copy_count",
        "index_reservation_bytes",
        "payload_allowance_bytes",
        "total_bytes",
        "cap_bytes"
      ],
      "properties": {
        "leg": {
          "const": "a0"
        },
        "cases": {
          "const": 48
        },
        "view_site_count": {
          "const": 10
        },
        "endpoint_count": {
          "const": 5
        },
        "hidden_width": {
          "type": "integer",
          "minimum": 1
        },
        "scalar_bytes": {
          "const": 4
        },
        "vector_count": {
          "const": 2400
        },
        "dense_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "dense_copy_count": {
          "const": 2
        },
        "atomic_dense_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "index_copy_count": {
          "const": 2
        },
        "index_reservation_bytes": {
          "const": 6291456
        },
        "payload_allowance_bytes": {
          "const": 2097152
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "cap_bytes": {
          "const": 33554432
        }
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_profile",
        "dense_bound",
        "leg",
        "leg_freeze_sha256",
        "model_id",
        "model_key",
        "output_path",
        "revision",
        "run_id"
      ],
      "properties": {
        "leg": {
          "enum": [
            "a0",
            "r1"
          ]
        },
        "leg_freeze_sha256": {
          "$ref": "#/$defs/sha"
        },
        "model_key": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "$ref": "#/$defs/rev"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "output_path": {
          "$ref": "#/$defs/path"
        },
        "dense_bound": {
          "$ref": "#/$defs/any_dense"
        },
        "binding_profile": {
          "const": "a0x-pair-scope-v2"
        }
      }
    },
    "any_dense": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leg",
        "cases",
        "view_site_count",
        "endpoint_count",
        "hidden_width",
        "scalar_bytes",
        "vector_count",
        "dense_bytes",
        "dense_copy_count",
        "atomic_dense_bytes",
        "index_copy_count",
        "index_reservation_bytes",
        "payload_allowance_bytes",
        "total_bytes",
        "cap_bytes"
      ],
      "properties": {
        "leg": {
          "enum": [
            "a0",
            "r1"
          ]
        },
        "cases": {
          "const": 48
        },
        "view_site_count": {
          "type": "integer",
          "minimum": 1
        },
        "endpoint_count": {
          "type": "integer",
          "minimum": 1
        },
        "hidden_width": {
          "type": "integer",
          "minimum": 1
        },
        "scalar_bytes": {
          "const": 4
        },
        "vector_count": {
          "type": "integer",
          "minimum": 1
        },
        "dense_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "dense_copy_count": {
          "const": 2
        },
        "atomic_dense_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "index_copy_count": {
          "const": 2
        },
        "index_reservation_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "payload_allowance_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "cap_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "result_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_profile",
        "dense_bound",
        "leg",
        "leg_freeze_sha256",
        "model_id",
        "model_key",
        "output_path",
        "revision",
        "run_id"
      ],
      "properties": {
        "leg": {
          "const": "a0"
        },
        "leg_freeze_sha256": {
          "$ref": "#/$defs/sha"
        },
        "model_key": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "$ref": "#/$defs/rev"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "output_path": {
          "$ref": "#/$defs/path"
        },
        "dense_bound": {
          "$ref": "#/$defs/dense"
        },
        "binding_profile": {
          "const": "a0x-pair-scope-v2"
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_successes",
        "family_success_rate",
        "family_success_wilson_95",
        "macro_f1",
        "accuracy",
        "per_domain_accuracy"
      ],
      "properties": {
        "family_successes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "family_success_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "family_success_wilson_95": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "macro_f1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "accuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "per_domain_accuracy": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "primary_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tuple-0::sentinel",
        "tuple-0::final_transformation_token",
        "tuple-0::mean_transformation_span",
        "tuple-2::sentinel",
        "tuple-2::final_transformation_token",
        "tuple-2::mean_transformation_span",
        "tuple-4::sentinel",
        "tuple-4::final_transformation_token",
        "tuple-4::mean_transformation_span",
        "tuple-6::sentinel",
        "tuple-6::final_transformation_token",
        "tuple-6::mean_transformation_span"
      ],
      "properties": {
        "tuple-0::sentinel": {
          "$ref": "#/$defs/metric"
        },
        "tuple-0::final_transformation_token": {
          "$ref": "#/$defs/metric"
        },
        "tuple-0::mean_transformation_span": {
          "$ref": "#/$defs/metric"
        },
        "tuple-2::sentinel": {
          "$ref": "#/$defs/metric"
        },
        "tuple-2::final_transformation_token": {
          "$ref": "#/$defs/metric"
        },
        "tuple-2::mean_transformation_span": {
          "$ref": "#/$defs/metric"
        },
        "tuple-4::sentinel": {
          "$ref": "#/$defs/metric"
        },
        "tuple-4::final_transformation_token": {
          "$ref": "#/$defs/metric"
        },
        "tuple-4::mean_transformation_span": {
          "$ref": "#/$defs/metric"
        },
        "tuple-6::sentinel": {
          "$ref": "#/$defs/metric"
        },
        "tuple-6::final_transformation_token": {
          "$ref": "#/$defs/metric"
        },
        "tuple-6::mean_transformation_span": {
          "$ref": "#/$defs/metric"
        }
      }
    },
    "surface_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tuple-0::sentinel",
        "tuple-2::sentinel",
        "tuple-4::sentinel",
        "tuple-6::sentinel"
      ],
      "properties": {
        "tuple-0::sentinel": {
          "$ref": "#/$defs/metric"
        },
        "tuple-2::sentinel": {
          "$ref": "#/$defs/metric"
        },
        "tuple-4::sentinel": {
          "$ref": "#/$defs/metric"
        },
        "tuple-6::sentinel": {
          "$ref": "#/$defs/metric"
        }
      }
    },
    "final_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem_only::sentinel",
        "transformation_only::sentinel",
        "transformation_only::final_transformation_token",
        "transformation_only::mean_transformation_span",
        "problem_plus_transformation::sentinel",
        "problem_plus_transformation::final_transformation_token",
        "problem_plus_transformation::mean_transformation_span",
        "problem_plus_solution::sentinel",
        "problem_plus_solution::final_transformation_token",
        "problem_plus_solution::mean_transformation_span"
      ],
      "properties": {
        "problem_only::sentinel": {
          "$ref": "#/$defs/metric"
        },
        "transformation_only::sentinel": {
          "$ref": "#/$defs/metric"
        },
        "transformation_only::final_transformation_token": {
          "$ref": "#/$defs/metric"
        },
        "transformation_only::mean_transformation_span": {
          "$ref": "#/$defs/metric"
        },
        "problem_plus_transformation::sentinel": {
          "$ref": "#/$defs/metric"
        },
        "problem_plus_transformation::final_transformation_token": {
          "$ref": "#/$defs/metric"
        },
        "problem_plus_transformation::mean_transformation_span": {
          "$ref": "#/$defs/metric"
        },
        "problem_plus_solution::sentinel": {
          "$ref": "#/$defs/metric"
        },
        "problem_plus_solution::final_transformation_token": {
          "$ref": "#/$defs/metric"
        },
        "problem_plus_solution::mean_transformation_span": {
          "$ref": "#/$defs/metric"
        }
      }
    },
    "primary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "multiplicity",
        "combinations",
        "observed_max_family_successes",
        "max_statistic_p",
        "maximum_macro_f1",
        "null_maxima_sha256"
      ],
      "properties": {
        "multiplicity": {
          "const": 12
        },
        "combinations": {
          "$ref": "#/$defs/primary_map"
        },
        "observed_max_family_successes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "max_statistic_p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximum_macro_f1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "null_maxima_sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "multiplicity",
        "combinations",
        "maximum_macro_f1"
      ],
      "properties": {
        "multiplicity": {
          "const": 4
        },
        "combinations": {
          "$ref": "#/$defs/surface_map"
        },
        "maximum_macro_f1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "descriptive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rescues_primary",
        "tuple_index",
        "combinations"
      ],
      "properties": {
        "rescues_primary": {
          "const": false
        },
        "tuple_index": {
          "type": "integer",
          "minimum": 7
        },
        "combinations": {
          "$ref": "#/$defs/final_map"
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_statistic_p_at_most",
        "macro_f1_margin_at_least",
        "family_successes_at_least",
        "passed"
      ],
      "properties": {
        "max_statistic_p_at_most": {
          "const": 0.05
        },
        "macro_f1_margin_at_least": {
          "const": 0.1
        },
        "family_successes_at_least": {
          "const": 19
        },
        "passed": {
          "type": "boolean"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_class",
        "authorization_chain",
        "claim_ids",
        "descriptive_final_block",
        "empirical",
        "evidence_eligible",
        "expert_validated",
        "macro_f1_margin_over_surface",
        "outcome_rule",
        "p_value",
        "pair_binding",
        "primary",
        "scientific_status",
        "score_quantization_decimals",
        "status",
        "surface_baseline"
      ],
      "properties": {
        "artifact_class": {
          "const": "a0x-statistical-result"
        },
        "empirical": {
          "const": true
        },
        "scientific_status": {
          "const": "exploratory"
        },
        "evidence_eligible": {
          "const": false
        },
        "expert_validated": {
          "const": false
        },
        "claim_ids": {
          "type": "array",
          "maxItems": 0
        },
        "pair_binding": {
          "$ref": "#/$defs/result_pair"
        },
        "status": {
          "enum": [
            "positive",
            "null"
          ]
        },
        "p_value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "score_quantization_decimals": {
          "const": 12
        },
        "primary": {
          "$ref": "#/$defs/primary"
        },
        "surface_baseline": {
          "$ref": "#/$defs/surface"
        },
        "macro_f1_margin_over_surface": {
          "type": "number"
        },
        "descriptive_final_block": {
          "$ref": "#/$defs/descriptive"
        },
        "outcome_rule": {
          "$ref": "#/$defs/outcome"
        },
        "authorization_chain": {
          "$ref": "#/$defs/authorization_chain"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "positive"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "outcome_rule": {
                "properties": {
                  "passed": {
                    "const": true
                  }
                },
                "required": [
                  "passed"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "null"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "outcome_rule": {
                "properties": {
                  "passed": {
                    "const": false
                  }
                },
                "required": [
                  "passed"
                ]
              }
            }
          }
        }
      ]
    },
    "r1_dense": {
      "allOf": [
        {
          "$ref": "#/$defs/any_dense"
        },
        {
          "properties": {
            "leg": {
              "const": "r1"
            },
            "view_site_count": {
              "const": 2
            },
            "endpoint_count": {
              "const": 2
            },
            "vector_count": {
              "const": 192
            },
            "index_reservation_bytes": {
              "const": 1048576
            },
            "payload_allowance_bytes": {
              "const": 524288
            },
            "cap_bytes": {
              "const": 4194304
            }
          }
        }
      ]
    },
    "r1_pair": {
      "allOf": [
        {
          "$ref": "#/$defs/pair"
        },
        {
          "properties": {
            "leg": {
              "const": "r1"
            },
            "dense_bound": {
              "$ref": "#/$defs/r1_dense"
            }
          }
        }
      ]
    },
    "r1_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_successes",
        "family_success_rate",
        "family_success_wilson_95",
        "macro_f1",
        "accuracy",
