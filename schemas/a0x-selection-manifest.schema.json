{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_class", "empirical", "scientific_status", "evidence_eligible", "expert_validated", "claim_ids", "selection_corpus_sha256", "selection_path", "selected_case_count", "source_cases_path", "source_corpus_manifest_path", "source_cases_sha256", "source_corpus_manifest_sha256", "selection_rule", "cases", "target_content_reads"],
  "properties": {
    "artifact_class": {"const": "a0x-selection-manifest"},
    "empirical": {"const": true},
    "scientific_status": {"const": "exploratory"},
    "evidence_eligible": {"const": false},
    "expert_validated": {"const": false},
    "claim_ids": {"type": "array", "maxItems": 0},
    "selection_corpus_sha256": {"$ref": "#/$defs/sha"},
    "selection_path": {"const": "experiments/a0x-six-model/a0-selection-manifest.json"},
    "selected_case_count": {"const": 48},
    "source_cases_path": {"$ref": "#/$defs/path"},
    "source_corpus_manifest_path": {"$ref": "#/$defs/path"},
    "source_cases_sha256": {"$ref": "#/$defs/sha"},
    "source_corpus_manifest_sha256": {"$ref": "#/$defs/sha"},
    "selection_rule": {"$ref": "#/$defs/selection_rule"},
    "cases": {"type": "array", "minItems": 48, "maxItems": 48, "items": {"$ref": "#/$defs/case"}},
    "target_content_reads": {"const": 0}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "selection_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases_per_family", "families_per_domain", "family_order", "domain_order"],
      "properties": {
        "cases_per_family": {"const": 2},
        "families_per_domain": {"const": 4},
        "family_order": {"const": "lexicographic"},
        "domain_order": {"const": "frozen"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "case_content_sha256", "domain", "problem_family_id", "split"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "case_content_sha256": {"$ref": "#/$defs/sha"},
        "domain": {"enum": ["agriculture", "energy", "manufacturing", "medicine", "software", "transport"]},
        "problem_family_id": {"type": "string", "minLength": 1},
        "split": {"type": "string", "minLength": 1}
      }
    }
  }
}
