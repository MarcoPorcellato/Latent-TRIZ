{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoPorcellato/Latent-TRIZ/schemas/a0x-gh-2.97.0-verification-result.schema.json",
  "type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/result"},
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"},
    "result": {"type": "object", "additionalProperties": false, "required": ["attestation", "verificationResult"], "properties": {
      "attestation": {"type": "object", "additionalProperties": false, "required": ["bundle", "bundle_url", "initiator"], "properties": {"bundle": {"type": "object"}, "bundle_url": {"type": "string"}, "initiator": {"type": "string"}}}, "verificationResult": {"$ref": "#/$defs/verification"}
    }},
    "verification": {"type": "object", "additionalProperties": false, "required": ["mediaType", "verifiedIdentity", "statement", "signature", "verifiedTimestamps"], "properties": {
      "mediaType": {"const": "application/vnd.dev.sigstore.verificationresult+json;version=0.1"},
      "verifiedIdentity": {"type": "object", "additionalProperties": false, "required": ["subjectAlternativeName", "issuer", "runnerEnvironment"], "properties": {"subjectAlternativeName": {"$ref": "#/$defs/san_matcher"}, "issuer": {"$ref": "#/$defs/issuer_matcher"}, "runnerEnvironment": {"const": "github-hosted"}}},
      "statement": {"$ref": "#/$defs/statement"}, "signature": {"$ref": "#/$defs/signature"},
      "verifiedTimestamps": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["type", "uri", "timestamp"], "properties": {"type": {"enum": ["Tlog", "TimestampAuthority"]}, "uri": {"type": "string", "minLength": 1}, "timestamp": {"$ref": "#/$defs/timestamp"}}}}
    }},
    "san_matcher": {"type": "object", "additionalProperties": false, "required": ["subjectAlternativeName", "regexp"], "properties": {"subjectAlternativeName": {"type": "string"}, "regexp": {"type": "string", "maxLength": 1024}}},
    "issuer_matcher": {"type": "object", "additionalProperties": false, "required": ["issuer", "regexp"], "properties": {"issuer": {"type": "string"}, "regexp": {"type": "string", "maxLength": 1024}}},
    "statement": {"type": "object", "additionalProperties": false, "required": ["_type", "subject", "predicateType", "predicate"], "properties": {
      "_type": {"const": "https://in-toto.io/Statement/v1"}, "subject": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "digest"], "properties": {"name": {"const": "hosted-gate-a-evidence.json"}, "digest": {"type": "object", "additionalProperties": false, "required": ["sha256"], "properties": {"sha256": {"$ref": "#/$defs/sha"}}}}}},
      "predicateType": {"const": "https://slsa.dev/provenance/v1"}, "predicate": {"type": "object", "additionalProperties": false, "required": ["buildDefinition", "runDetails"], "properties": {"buildDefinition": {"$ref": "#/$defs/build_definition"}, "runDetails": {"$ref": "#/$defs/run_details"}}}
    }},
    "build_definition": {"type": "object", "additionalProperties": false, "required": ["buildType", "externalParameters", "internalParameters", "resolvedDependencies"], "properties": {
      "buildType": {"const": "https://actions.github.io/buildtypes/workflow/v1"}, "externalParameters": {"type": "object", "additionalProperties": false, "required": ["workflow"], "properties": {"workflow": {"type": "object", "additionalProperties": false, "required": ["ref", "repository", "path"], "properties": {"ref": {"const": "refs/heads/main"}, "repository": {"type": "string", "minLength": 1}, "path": {"const": ".github/workflows/a0x-hosted-gate-a.yml"}}}}},
      "internalParameters": {"type": "object", "additionalProperties": false, "required": ["github"], "properties": {"github": {"type": "object", "additionalProperties": false, "required": ["event_name", "runner_environment", "repository_id", "repository_owner_id"], "properties": {"event_name": {"const": "push"}, "runner_environment": {"const": "github-hosted"}, "repository_id": {"type": "string", "minLength": 1}, "repository_owner_id": {"type": "string", "minLength": 1}}}}},
      "resolvedDependencies": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["uri", "digest"], "properties": {"uri": {"type": "string", "minLength": 1}, "digest": {"type": "object", "additionalProperties": false, "required": ["gitCommit"], "properties": {"gitCommit": {"$ref": "#/$defs/revision"}}}}}}
    }},
    "run_details": {"type": "object", "additionalProperties": false, "required": ["builder", "metadata"], "properties": {"builder": {"type": "object", "additionalProperties": false, "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}}}, "metadata": {"type": "object", "additionalProperties": false, "required": ["invocationId"], "properties": {"invocationId": {"type": "string", "minLength": 1}}}}},
    "signature": {"type": "object", "additionalProperties": false, "required": ["certificate"], "properties": {"certificate": {"type": "object", "additionalProperties": false, "required": ["certificateIssuer", "subjectAlternativeName", "issuer", "buildSignerURI", "buildSignerDigest", "runnerEnvironment", "sourceRepositoryURI", "sourceRepositoryDigest", "sourceRepositoryRef", "buildConfigURI", "buildConfigDigest", "buildTrigger"], "properties": {
      "certificateIssuer": {"type": "string", "minLength": 1}, "subjectAlternativeName": {"type": "string", "minLength": 1}, "issuer": {"type": "string", "minLength": 1}, "githubWorkflowTrigger": {"type": "string", "minLength": 1}, "githubWorkflowSHA": {"$ref": "#/$defs/revision"}, "githubWorkflowName": {"type": "string", "minLength": 1}, "githubWorkflowRepository": {"type": "string", "minLength": 1}, "githubWorkflowRef": {"type": "string", "minLength": 1}, "buildSignerURI": {"type": "string", "minLength": 1}, "buildSignerDigest": {"$ref": "#/$defs/revision"}, "runnerEnvironment": {"const": "github-hosted"}, "sourceRepositoryURI": {"type": "string", "minLength": 1}, "sourceRepositoryDigest": {"$ref": "#/$defs/revision"}, "sourceRepositoryRef": {"const": "refs/heads/main"}, "sourceRepositoryIdentifier": {"type": "string", "minLength": 1}, "sourceRepositoryOwnerURI": {"type": "string", "minLength": 1}, "sourceRepositoryOwnerIdentifier": {"type": "string", "minLength": 1}, "buildConfigURI": {"type": "string", "minLength": 1}, "buildConfigDigest": {"$ref": "#/$defs/revision"}, "buildTrigger": {"const": "push"}, "runInvocationURI": {"type": "string", "minLength": 1}, "sourceRepositoryVisibilityAtSigning": {"type": "string", "minLength": 1}
    }}}}
  }
}
