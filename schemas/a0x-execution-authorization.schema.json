{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approved_dossier_commitment",
    "artifact_class",
    "authorization_status",
    "claim_ids",
    "commitment_profile",
    "empirical",
    "evidence_eligible",
    "expert_validated",
    "pair_binding",
    "scientific_status",
    "repository",
    "source_head",
    "material_contract_raw_sha256",
    "ccp",
    "qualification_receipt_raw_sha256",
    "guard_exec_argv_commitment",
    "max_guard_exec_count",
    "stop_boundary",
    "authorization_id",
    "attempt_id"
  ],
  "properties": {
    "artifact_class": {
      "const": "a0x-execution-authorization"
    },
    "empirical": {
      "const": true
    },
    "scientific_status": {
      "const": "exploratory"
    },
    "evidence_eligible": {
      "const": false
    },
    "expert_validated": {
      "const": false
    },
    "claim_ids": {
      "type": "array",
      "maxItems": 0
    },
    "pair_binding": {
      "$ref": "#/$defs/pair"
    },
    "authorization_status": {
      "const": "authorized"
    },
    "commitment_profile": {
      "const": "a0x-execution-authorization-json-v2"
    },
    "approved_dossier_commitment": {
      "$ref": "#/$defs/dossier_commitment"
    },
    "repository": {
      "const": "MarcoPorcellato/Latent-TRIZ"
    },
    "source_head": {
      "$ref": "#/$defs/rev"
    },
    "material_contract_raw_sha256": {
      "$ref": "#/$defs/sha"
    },
    "ccp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "source_commit", "qualified_source_tree", "sha256", "version"],
      "properties": {
        "path": {"const": "/Users/marco1/.cargo/bin/commit-ci-preflight"},
        "source_commit": {"const": "c91915adcb8706898574c0c74d033b9ff991eefb"},
        "qualified_source_tree": {"const": "687fcaaa3643d35a66ba748409e5621d13e25dd7"},
        "sha256": {"const": "72a3458987e18313ceacfc97d8e7902d2d5338eb8eb609320fd37ca58aedd4be"},
        "version": {"const": "commit-ci-preflight 0.1.0"}
      }
    },
    "qualification_receipt_raw_sha256": {
      "$ref": "#/$defs/sha"
    },
    "guard_exec_argv_commitment": {
      "$ref": "#/$defs/sha"
    },
    "max_guard_exec_count": {
      "const": 1
    },
    "stop_boundary": {"enum": ["before_model_load", "after_first_terminal_outcome", "after_one_sealed_target_read"]},
    "authorization_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rev": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
    },
    "dense": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leg",
        "cases",
        "view_site_count",
        "endpoint_count",
        "hidden_width",
        "scalar_bytes",
        "vector_count",
        "dense_bytes",
        "dense_copy_count",
        "atomic_dense_bytes",
        "index_copy_count",
        "index_reservation_bytes",
        "payload_allowance_bytes",
        "total_bytes",
        "cap_bytes"
      ],
      "properties": {
        "leg": {
          "enum": [
            "a0",
            "r1"
          ]
        },
        "cases": {
          "const": 48
        },
        "view_site_count": {
          "type": "integer",
          "minimum": 1
        },
        "endpoint_count": {
          "type": "integer",
          "minimum": 1
        },
        "hidden_width": {
          "type": "integer",
          "minimum": 1
        },
        "scalar_bytes": {
          "const": 4
        },
        "vector_count": {
          "type": "integer",
          "minimum": 1
        },
        "dense_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "dense_copy_count": {
          "const": 2
        },
        "atomic_dense_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "index_copy_count": {
          "const": 2
        },
        "index_reservation_bytes": {
          "enum": [
            6291456,
            1048576
          ]
        },
        "payload_allowance_bytes": {
          "enum": [
            2097152,
            524288
          ]
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "cap_bytes": {
          "enum": [
            33554432,
            4194304
          ]
        }
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_profile",
        "dense_bound",
        "leg",
        "leg_freeze_sha256",
        "model_id",
        "model_key",
        "output_path",
        "revision",
        "run_id"
      ],
      "properties": {
        "leg": {
          "enum": [
            "a0",
            "r1"
          ]
        },
        "leg_freeze_sha256": {
          "$ref": "#/$defs/sha"
        },
        "model_key": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "$ref": "#/$defs/rev"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "output_path": {
          "$ref": "#/$defs/path"
        },
        "dense_bound": {
          "$ref": "#/$defs/dense"
        },
        "binding_profile": {
          "const": "a0x-pair-scope-v2"
        }
      }
    },
    "dossier_commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "commitment_sha256"
      ],
      "properties": {
        "profile": {
          "const": "a0x-approval-dossier-json-v2"
        },
        "commitment_sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    }
  }
}
