{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approved_dossier_commitment",
    "artifact_class",
    "authorization_status",
    "claim_ids",
    "commitment_profile",
    "empirical",
    "evidence_eligible",
    "expert_validated",
    "pair_binding",
    "scientific_status",
    "repository",
    "implementation_source_head",
    "source_head",
    "material_contract_raw_sha256",
    "ccp",
    "authorization_inlet_path",
    "guard_launch",
    "guard_preflight_observation",
    "qualification_evidence",
    "max_guard_exec_count",
    "stop_boundary",
    "authorization_id",
    "attempt_id"
  ],
  "properties": {
    "artifact_class": {
      "const": "a0x-execution-authorization"
    },
    "empirical": {
      "const": true
    },
    "scientific_status": {
      "const": "exploratory"
    },
    "evidence_eligible": {
      "const": false
    },
    "expert_validated": {
      "const": false
    },
    "claim_ids": {
      "type": "array",
      "maxItems": 0
    },
    "pair_binding": {
      "$ref": "#/$defs/pair"
    },
    "authorization_status": {
      "const": "authorized"
    },
    "commitment_profile": {
      "const": "a0x-execution-authorization-json-v2"
    },
    "approved_dossier_commitment": {
      "$ref": "#/$defs/dossier_commitment"
    },
    "repository": {
      "const": "MarcoPorcellato/Latent-TRIZ"
    },
    "source_head": {
      "$ref": "#/$defs/rev"
    },
    "implementation_source_head": {
      "$ref": "#/$defs/rev"
    },
    "material_contract_raw_sha256": {
      "$ref": "#/$defs/sha"
    },
    "ccp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable_name", "source_commit", "qualified_source_tree", "sha256", "version"],
      "properties": {
        "executable_name": {"const": "commit-ci-preflight"},
        "source_commit": {"$ref": "#/$defs/rev"},
        "qualified_source_tree": {"$ref": "#/$defs/rev"},
        "sha256": {"$ref": "#/$defs/sha"},
        "version": {"type": "string", "pattern": "^commit-ci-preflight [^\\s]+$"}
      }
    },
    "authorization_inlet_path": {
      "$ref": "#/$defs/runtime_authorization_path"
    },
    "guard_launch": {
      "$ref": "#/$defs/guard_launch"
    },
    "guard_preflight_observation": {
      "$ref": "#/$defs/guard_preflight_observation"
    },
    "qualification_evidence": {
      "$ref": "#/$defs/qualification_evidence"
    },
    "max_guard_exec_count": {
      "const": 1
    },
    "stop_boundary": {"enum": ["before_model_load", "after_first_terminal_outcome", "after_one_sealed_target_read"]},
    "authorization_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rev": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
    },
    "dense": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leg",
        "cases",
        "view_site_count",
        "endpoint_count",
        "hidden_width",
        "scalar_bytes",
        "vector_count",
        "dense_bytes",
        "dense_copy_count",
        "atomic_dense_bytes",
        "index_copy_count",
        "index_reservation_bytes",
        "payload_allowance_bytes",
        "total_bytes",
        "cap_bytes"
      ],
      "properties": {
        "leg": {
          "enum": [
            "a0",
            "r1"
          ]
        },
        "cases": {
          "const": 48
        },
        "view_site_count": {
          "type": "integer",
          "minimum": 1
        },
        "endpoint_count": {
          "type": "integer",
          "minimum": 1
        },
        "hidden_width": {
          "type": "integer",
          "minimum": 1
        },
        "scalar_bytes": {
          "const": 4
        },
        "vector_count": {
          "type": "integer",
          "minimum": 1
        },
        "dense_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "dense_copy_count": {
          "const": 2
        },
        "atomic_dense_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "index_copy_count": {
          "const": 2
        },
        "index_reservation_bytes": {
          "enum": [
            6291456,
            1048576
          ]
        },
        "payload_allowance_bytes": {
          "enum": [
            2097152,
            524288
          ]
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "cap_bytes": {
          "enum": [
            33554432,
            4194304
          ]
        }
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_profile",
        "dense_bound",
        "leg",
        "leg_freeze_sha256",
        "model_id",
        "model_key",
        "output_path",
        "revision",
        "run_id"
      ],
      "properties": {
        "leg": {
          "enum": [
            "a0",
            "r1"
          ]
        },
        "leg_freeze_sha256": {
          "$ref": "#/$defs/sha"
        },
        "model_key": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "$ref": "#/$defs/rev"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "output_path": {
          "$ref": "#/$defs/path"
        },
        "dense_bound": {
          "$ref": "#/$defs/dense"
        },
        "binding_profile": {
          "const": "a0x-pair-scope-v2"
        }
      }
    },
    "runtime_authorization_path": {
      "type": "string",
      "pattern": "^\\.a0x-runtime/(?!.*(?:/|^)\\.{1,2}(?:/|$))authorizations/(?:a0|r1)/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+\\.json$"
    },
    "dossier_commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "commitment_sha256"
      ],
      "properties": {
        "profile": {
          "const": "a0x-approval-dossier-json-v2"
        },
        "commitment_sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "guard_launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["launch_profile", "ccp", "python", "cwd_kind", "source_head", "child_script", "launch_descriptor", "environment_template", "resource", "timeouts", "argv_template"],
      "properties": {
        "launch_profile": {"const": "a0x-guard-launch-v2"},
        "ccp": {"$ref": "#/$defs/runtime_role_ccp"},
        "python": {"$ref": "#/$defs/runtime_role_python"},
        "cwd_kind": {"const": "repository_root"},
        "source_head": {"$ref": "#/$defs/rev"},
        "child_script": {"$ref": "#/$defs/child_script"},
        "launch_descriptor": {"$ref": "#/$defs/runtime_file"},
        "environment_template": {"const": ["HF_HUB_OFFLINE=1", "TRANSFORMERS_OFFLINE=1", "HF_DATASETS_OFFLINE=1", "TOKENIZERS_PARALLELISM=false", "PYTHONNOUSERSITE=1"]},
        "resource": {"$ref": "#/$defs/guard_resource"},
        "timeouts": {"$ref": "#/$defs/timeouts"},
        "argv_template": {"type": "array", "minItems": 26, "maxItems": 26, "items": {"type": "string", "minLength": 1}}
      }
    },
    "runtime_role_ccp": {
      "type": "object", "additionalProperties": false, "required": ["role", "sha256"],
      "properties": {"role": {"const": "ccp"}, "sha256": {"$ref": "#/$defs/sha"}}
    },
    "guard_preflight_observation": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "path"],
      "properties": {
        "profile": {"const": "a0x-guard-preflight-observation-v1"},
        "path": {"type": "string", "pattern": "^\\.a0x-runtime/observations/[A-Za-z0-9._/-]+/guard-preflight-observation\\.json$"}
      }
    },
    "runtime_role_python": {
      "type": "object", "additionalProperties": false, "required": ["role", "sha256"],
      "properties": {"role": {"const": "python"}, "sha256": {"$ref": "#/$defs/sha"}}
    },
    "child_script": {
      "type": "object", "additionalProperties": false, "required": ["role", "path", "sha256"],
      "properties": {"role": {"const": "child"}, "path": {"const": "scripts/a0x_material_child.py"}, "sha256": {"$ref": "#/$defs/sha"}}
    },
    "runtime_file": {
      "type": "object", "additionalProperties": false, "required": ["role", "path", "sha256"],
      "properties": {"role": {"const": "descriptor"}, "path": {"type": "string", "pattern": "^\\.a0x-runtime/(?!.*(?:/|^)\\.{1,2}(?:/|$))(?:authorizations|launches|claims|observations|qualification|bin)/[A-Za-z0-9._/-]+$"}, "sha256": {"$ref": "#/$defs/sha"}}
    },
    "guard_resource": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "workload_family", "executor", "cache_state", "execution_mode", "target_platform", "memory_limit_bytes"],
      "properties": {
        "profile": {"const": "a0x-material"}, "workload_family": {"const": "latent-triz-a0x-v1"}, "executor": {"const": "native"}, "cache_state": {"const": "warm"}, "execution_mode": {"const": "native"}, "target_platform": {"const": "macos-arm64"}, "memory_limit_bytes": {"const": 8589934592}
      }
    },
    "timeouts": {
      "type": "object", "additionalProperties": false,
      "required": ["outer_timeout_seconds", "internal_budget_seconds", "cleanup_margin_seconds", "admission_timeout_seconds"],
      "properties": {"outer_timeout_seconds": {"const": 3600}, "internal_budget_seconds": {"const": 3300}, "cleanup_margin_seconds": {"const": 300}, "admission_timeout_seconds": {"const": 300}}
    },
    "qualification_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_class", "evidence_profile", "qualification_receipt_id", "qualification_receipt_raw_sha256", "qualified_source_head", "generation", "ccp", "public_evidence"],
      "properties": {
        "artifact_class": {"const": "a0x-qualification-evidence"}, "evidence_profile": {"const": "a0x-qualification-evidence-v1"}, "qualification_receipt_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "qualification_receipt_raw_sha256": {"$ref": "#/$defs/sha"}, "qualified_source_head": {"$ref": "#/$defs/rev"}, "generation": {"type": "integer", "minimum": 1},
        "ccp": {"$ref": "#/$defs/evidence_ccp"}, "public_evidence": {"$ref": "#/$defs/public_evidence"}
      }
    },
    "evidence_ccp": {
      "type": "object", "additionalProperties": false, "required": ["executable_name", "source_commit", "qualified_source_tree", "binary_sha256", "version"],
      "properties": {"executable_name": {"const": "commit-ci-preflight"}, "source_commit": {"$ref": "#/$defs/rev"}, "qualified_source_tree": {"$ref": "#/$defs/rev"}, "binary_sha256": {"$ref": "#/$defs/sha"}, "version": {"type": "string", "pattern": "^commit-ci-preflight [^\\s]+$"}}
    },
    "public_evidence": {
      "type": "object", "additionalProperties": false, "required": ["branch", "path", "commit"],
      "properties": {"branch": {"type": "string", "pattern": "^ccp-evidence/[a-f0-9]{40}$"}, "path": {"const": ".ccp/receipt.json"}, "commit": {"$ref": "#/$defs/rev"}}
    }
  }
}
