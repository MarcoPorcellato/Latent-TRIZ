{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoPorcellato/Latent-TRIZ/schemas/a0x-hosted-gate-a-capture-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["repository", "source_head", "source_tree", "run_id", "run_attempt", "artifact_id", "artifact_name", "archive_sha256", "archive_size_bytes", "manifest_sha256", "expires_at", "output_root"],
  "properties": {
    "repository": {"const": "MarcoPorcellato/Latent-TRIZ"},
    "source_head": {"$ref": "#/$defs/revision"},
    "source_tree": {"$ref": "#/$defs/revision"},
    "run_id": {"$ref": "#/$defs/positive_integer"},
    "run_attempt": {"type": "integer", "const": 1},
    "artifact_id": {"$ref": "#/$defs/positive_integer"},
    "artifact_name": {"const": "a0x-hosted-gate-a-evidence"},
    "archive_sha256": {"$ref": "#/$defs/sha256"},
    "archive_size_bytes": {"$ref": "#/$defs/positive_integer"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "output_root": {"type": "string", "pattern": "^/[^\\u0000]+$"}
  },
  "$defs": {
    "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "positive_integer": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"}
  }
}
